# Production environment template. Copy values into your secret manager or
# deployment platform and replace every CHANGE_ME value before exposing Modex.

# --- Core URLs ---
APP_BASE_URL=https://modex-api.example.com
FRONTEND_BASE_URL=https://modex.example.com
NEXT_PUBLIC_API_BASE_URL=https://modex-api.example.com
INTERNAL_API_BASE_URL=http://backend:8671
CORS_ALLOW_ORIGINS=https://modex.example.com
BACKEND_PORT=8671
FRONTEND_PORT=3456
DOCS_DEPLOY_MAX_BYTES=536870912

# --- PostgreSQL / pgvector ---
DATABASE_URL=postgres://modex:CHANGE_ME@postgres:5432/modex?sslmode=disable
POSTGRES_DB=modex
POSTGRES_USER=modex
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0

# --- Object storage ---
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=https://modex-files.example.com
MINIO_BUCKET=modex

# --- Search ---
MEILI_ENV=production
MEILI_MASTER_KEY=CHANGE_ME
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_PUBLIC_URL=https://modex-search.example.com
HYBRID_KEYWORD_WEIGHT=0.6
HYBRID_SEMANTIC_WEIGHT=0.4

# --- Auth ---
AUTH_MODE=oidc
# Set true if every anonymous visitor should be sent to OIDC immediately.
AUTO_LOGIN=false
SUPER_ADMIN_USERS=admin@example.com
KEYCLOAK_BASE_URL=https://keycloak.example.com
KEYCLOAK_REALM=your-realm
OIDC_CLIENT_ID=modex
OIDC_CLIENT_SECRET=CHANGE_ME
OIDC_REDIRECT_URL=https://modex-api.example.com/api/auth/callback
OIDC_SCOPES=openid profile email
OIDC_CLAIM_UNIQUE_ID=email
OIDC_CLAIM_AVATAR=picture
OIDC_CLAIM_DISPLAY_NAME=name
OIDC_CLAIM_SECONDARY_INFO=department
SESSION_COOKIE_NAME=modex_session
OAUTH_STATE_COOKIE_NAME=modex_oauth_state
COOKIE_DOMAIN=.example.com
COOKIE_SAME_SITE=lax
COOKIE_SECURE=true
SESSION_TTL=8h

# Only trust forwarding headers when Modex is behind a trusted reverse proxy.
TRUST_PROXY_HEADERS=true
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=60s
HTTP_IDLE_TIMEOUT=2m
HTTP_MAX_HEADER_BYTES=1048576
HTTP_MAX_BODY_BYTES=2097152
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_TOKEN_PER_MINUTE=30
RATE_LIMIT_SEARCH_PER_MINUTE=60
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_DEPLOY_PER_MINUTE=10

# --- Application config ---
# Leave empty when claim mappings above are sufficient. To use YAML, copy
# config.example.yaml to config.yaml, enable its Compose volume mount, and set:
# CONFIG_FILE=/app/config.yaml
CONFIG_FILE=

# --- AI / retrieval ---
# Configure concrete providers from the admin settings page after first login:
# 1. Set chat model base URL, model, and API key.
# 2. Set embedding base URL, model, API key, and dimension.
# 3. Run embedding reindex.
# 4. Run recall test with expected doc IDs before enabling semantic/hybrid search.

# --- Analytics ---
POSTHOG_HOST=https://app.posthog.com
POSTHOG_PROJECT_API_KEY=CHANGE_ME
POSTHOG_PERSONAL_API_KEY=CHANGE_ME
POSTHOG_PROJECT_ID=CHANGE_ME
POSTHOG_ENABLE_LOCAL=false

# --- Diagrams ---
# Use an internal Kroki deployment if document diagram source must stay on-prem.
NEXT_PUBLIC_KROKI_URL=https://kroki.example.com
