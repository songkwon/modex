# Go module proxy for `docker compose build` (use proxy.golang.org outside CN)
GOPROXY=https://goproxy.cn,direct

# --- Postgres ---
POSTGRES_DB=modex
POSTGRES_USER=modex
POSTGRES_PASSWORD=modex
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0

# --- MinIO (object storage) ---
MINIO_ROOT_USER=modex
MINIO_ROOT_PASSWORD=modex-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# --- Meilisearch ---
MEILI_ENV=development
MEILI_MASTER_KEY=modex-dev-key
MEILI_PORT=7700
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_PUBLIC_URL=http://localhost:7700

# --- Core / URLs ---
BACKEND_PORT=8671
FRONTEND_PORT=3456
# store snapshot dir; empty = in-memory
DATA_DIR=/data
DATA_SAVE_INTERVAL_SECONDS=60
# max deploy artifact size (512MB; default 100MB)
DOCS_DEPLOY_MAX_BYTES=536870912
APP_BASE_URL=http://localhost:8671
FRONTEND_BASE_URL=http://localhost:3456
# API base for the browser
NEXT_PUBLIC_API_BASE_URL=http://localhost:8671
# API base for server-side calls
INTERNAL_API_BASE_URL=http://backend:8671
CORS_ALLOW_ORIGINS=http://localhost:3456

# --- Kroki (diagram render server) ---
# Public kroki.io by default. For on-prem: `docker compose --profile kroki up -d`
# then set http://localhost:8000 so diagram source stays in-network.
NEXT_PUBLIC_KROKI_URL=https://kroki.io
# KROKI_PORT=8000

# --- MCP package dir for intranet download (GET /api/mcp/dist/*) ---
# MCP_DIST_DIR=/app/mcp-dist

# --- Auth (mock | oidc) ---
AUTH_MODE=mock
# When true, the frontend automatically starts login for anonymous visitors.
AUTO_LOGIN=false
# comma-separated usernames/emails
SUPER_ADMIN_USERS=dev
KEYCLOAK_BASE_URL=https://keycloak.example.com
KEYCLOAK_REALM=dev
OIDC_ISSUER_URL=
OIDC_AUTH_URL=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=
OIDC_END_SESSION_URL=
OIDC_CLIENT_ID=modex
OIDC_CLIENT_SECRET=change-me
OIDC_REDIRECT_URL=http://localhost:8671/api/auth/callback
OIDC_SCOPES='openid profile email'
SESSION_COOKIE_NAME=modex_session
OAUTH_STATE_COOKIE_NAME=modex_oauth_state
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
SESSION_TTL=8h
# Set true only behind a trusted reverse proxy.
TRUST_PROXY_HEADERS=false
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=60s
HTTP_IDLE_TIMEOUT=2m
HTTP_MAX_HEADER_BYTES=1048576
HTTP_MAX_BODY_BYTES=2097152
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_TOKEN_PER_MINUTE=30
RATE_LIMIT_SEARCH_PER_MINUTE=60
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_DEPLOY_PER_MINUTE=10

# --- Ask AI --- (empty = extractive fallback from search)
ASK_HTTP_URL=
ASK_HTTP_API_KEY=

# --- Search scoring (models are configured in the admin model page) ---
HYBRID_KEYWORD_WEIGHT=0.6
HYBRID_SEMANTIC_WEIGHT=0.4

# --- PostHog (single project; empty = no reading statistics) ---
POSTHOG_HOST=https://app.posthog.com
POSTHOG_PROJECT_API_KEY=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
