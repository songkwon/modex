# mock for local development, oidc for Keycloak.
AUTH_MODE=mock
KEYCLOAK_BASE_URL=https://keycloak.example.com
KEYCLOAK_REALM=dev
OIDC_ISSUER_URL=
OIDC_AUTH_URL=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=
OIDC_END_SESSION_URL=
OIDC_CLIENT_ID=modex
OIDC_CLIENT_SECRET=change-me
OIDC_REDIRECT_URL=http://localhost:8671/api/auth/callback
OIDC_SCOPES=openid profile email
SESSION_COOKIE_NAME=modex_session
OAUTH_STATE_COOKIE_NAME=modex_oauth_state
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

EMBEDDING_PROVIDER=mock
EMBEDDING_HTTP_URL=
EMBEDDING_HTTP_API_KEY=
